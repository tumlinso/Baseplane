{
  "schema_version": 3,
  "project": {
    "name": "baseplane"
  },
  "invariants": [
    {
      "id": "non-goals",
      "rule": "Do not add sequence file parsers, genome/motif databases, IUPAC core parsing, PWM/ontology policy, AnnData/HDF5/CSPACK ownership, training/autograd in Baseplane, dense per-base embeddings, unrestricted GPU VM, NVRTC first path, dynamic parallelism, cooperative-grid baseline, Tensor Core Boolean claims, broad reorganization, or CP-BP matrix types. Scoped exception authorized by the 2026-09-28 CUDA prototyping request: experiments/cuda_lab may contain isolated small parameterized floating-point inference probes and online routing/hierarchy tests. No production API, trainer/autograd framework, dense genome-token model, or unrestricted runtime is authorized by this exception.",
      "severity": "error",
      "scope": {}
    },
    {
      "id": "ownership",
      "rule": "Baseplane owns packed sequence representation, validity-aware low-level predicates, portable/prepared sequence programs, CPU/SIMD/CUDA execution, explicit residency, compact masks/events, generic segments, and scalar references. Cellerator owns the shared domain/order/identity/operand ABI, relation structures, runtime integration, numerical interpretation, fusion, planning, learned/mechanistic state, and partition policy. CelleraTorch is optional. CellShard remains read-only and parked. Experimental clarification for experiments/cuda_lab only: temporary local floating arithmetic, candidate grouping and conditional sequence-representation kernels are allowed to test the new hypothesis; they do not acquire shared numerical/ABI ownership or authorize edits in Cellerator, CelleraTorch, GlassHelix or CellShard.",
      "severity": "error",
      "scope": {}
    },
    {
      "id": "BP-CUDA-LAB-TRUTH",
      "rule": "This epic is scoped to experiments/cuda_lab; keep every prototype unpromoted until measured. No false claim of learned weights, lossless embeddings, genome-scale representation, GPU execution or speedup. Negative findings are first-class outcomes. Existing exact APIs and unrelated dirty files remain untouched.",
      "severity": "error",
      "scope": {
        "paths": [
          "experiments/cuda_lab"
        ]
      }
    }
  ],
  "tasks": [
    {
      "id": "BP-CUDA-LAB-00",
      "kind": "epic",
      "title": "CUDA-native online representation experiments",
      "objective": "Evaluate four minimal, creative CUDA mechanisms for Baseplane online hierarchical floating representations; retain at most two evidence-supported demonstrations, not a new general framework.",
      "priority": 1,
      "parallel_policy": "serial",
      "notes": "Read experiments/cuda_lab/START_HERE.md. Prewritten source and references are supplied. Existing BitOp work remains separate. Complete after BP-CUDA-LAB-90 evidence review; do not mark constituent kernels as validated before their gates run.",
